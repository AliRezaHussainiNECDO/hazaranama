# --- Android --------------------------------------------------------------
# توجه: قبلاً کل پوشه‌ی android/ نادیده گرفته می‌شد که یعنی هیچ‌کدام از
# تغییرات بومی (AndroidManifest.xml، build.gradle.kts، آیکون‌ها،
# google-services.json و غیره) هرگز commit نمی‌شدند. فقط artifact های
# ساخته‌شده را نادیده می‌گیریم، نه خودِ سورس را.
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/**/GeneratedPluginRegistrant.java
android/key.properties

