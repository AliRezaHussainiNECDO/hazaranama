# این فایل فقط یک نمونه است — مقدار واقعی هرگز اینجا یا در گیت قرار نگیرد.
# برای اجرای محلی با `supabase functions serve`، یک کپی به نام .env بسازید
# و کلید واقعی را در آن بگذارید (این فایل .env در .gitignore نادیده گرفته می‌شود).
#
# برای محیط واقعی (production) به‌جای این فایل از دستور زیر استفاده کنید:
#   supabase secrets set GEMINI_API_KEY=your_key_here

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
